;; @file unitree_low_state.wat
;; @brief Read Go2 telemetry through individually reviewed driver and steady-clock operations.
(module
  (type $driver (func (param i64 i32 i64 i64 i64 i64 i64) (result i32)))
  (import "uwvm_ros_v2" "capability.open" (func $open (param i32 i64 i64 i64) (result i32)))
  (import "uwvm_ros_v2" "driver.connect" (func $connect (type $driver)))
  (import "uwvm_ros_v2" "driver.submit" (func $submit (type $driver)))
  (import "uwvm_ros_v2" "driver.result" (func $result (type $driver)))
  (import "uwvm_ros_v2" "driver.disconnect" (func $disconnect (type $driver)))
  (import "uwvm_ros_v2" "clock.create" (func $clock_create (type $driver)))
  (import "uwvm_ros_v2" "clock.read" (func $clock_read (type $driver)))
  (memory $private 1 1)
  (data (i32.const 16) "go2-state")
  ;; Address 32 holds the pending sequence. Address 80 receives result lengths.
  (data (i32.const 48) "steady")
  (global $clock_cap (mut i64) (i64.const 0))
  (global $clock (mut i64) (i64.const 0))
  (global $cap (mut i64) (i64.const 0))
  (global $exchange (mut i32) (i32.const 0))

  (func $check (param $condition i32)
    (if (i32.eqz (local.get $condition)) (then unreachable)))

  (func $poll (param $operation i32) (result i32)
    (local $attempts i32)
    (local $status i32)
    (local $capacity i64)
    (local $required i64)
    (local.set $capacity (i64.const 40))
    (loop $again
      (if (i32.eqz (local.get $operation))
        (then (local.set $status
          (call $connect (global.get $cap) (i32.const 0) (i64.const 0) (i64.const 0)
            (i64.extend_i32_u (global.get $exchange)) (i64.const 40) (i64.const 80))))
        (else (local.set $status
          (call $result (global.get $cap) (i32.const 0) (i64.const 32) (i64.const 8)
            (i64.extend_i32_u (global.get $exchange)) (local.get $capacity) (i64.const 80)))))
      ;; EMSGSIZE reports the negotiated envelope size before consuming the result.
      (if (i32.and (local.get $operation) (i32.eq (local.get $status) (i32.const 90)))
        (then
          (local.set $required (i64.load (i32.const 80)))
          (if (i32.and (i64.gt_u (local.get $required) (local.get $capacity))
                       (i64.le_u (local.get $required) (i64.const 1040)))
            (then (local.set $capacity (local.get $required)) (br $again)))))
      (if (i32.eq (local.get $status) (i32.const 11))
        (then
          (local.set $attempts (i32.add (local.get $attempts) (i32.const 1)))
          (br_if $again (i32.lt_u (local.get $attempts) (i32.const 4000000))))))
    (local.get $status))

  (func $init_clock (param $scratch i32)
    (call $check (i32.eqz (call $open (i32.const 0) (i64.const 48) (i64.const 6) (i64.const 72))))
    (global.set $clock_cap (i64.load (i32.const 72)))
    (i64.store (local.get $scratch) (i64.const 0))
    (call $check (i32.eqz
      (call $clock_create (global.get $clock_cap) (i32.const 0)
        (i64.extend_i32_u (local.get $scratch)) (i64.const 8)
        (i64.extend_i32_u (global.get $exchange)) (i64.const 8) (i64.const 80))))
    (global.set $clock (i64.load (global.get $exchange))))

  (func $deadline (param $scratch i32) (result i64)
    (i64.store (local.get $scratch) (global.get $clock))
    (call $check (i32.eqz
      (call $clock_read (global.get $clock_cap) (i32.const 0)
        (i64.extend_i32_u (local.get $scratch)) (i64.const 8)
        (i64.extend_i32_u (global.get $exchange)) (i64.const 32) (i64.const 80))))
    (call $check (i64.eq (i64.load offset=16 (global.get $exchange)) (i64.const 1)))
    ;; Allow 1.5 seconds from this read within the reviewed 2-second request window.
    (i64.add (i64.load (global.get $exchange)) (i64.const 1500000000)))

  (func $send (param $request i32) (param $sequence i64) (param $until i64) (result i32)
    (i64.store (local.get $request) (local.get $sequence))
    (i64.store offset=8 (local.get $request) (local.get $until))
    (i64.store offset=16 (local.get $request) (i64.const 24))
    (i64.store offset=24 (local.get $request) (i64.const 1))
    (i64.store offset=32 (local.get $request) (i64.const 0))
    (i64.store offset=40 (local.get $request) (i64.const 16))
    (call $submit (global.get $cap) (i32.const 0)
      (i64.extend_i32_u (local.get $request)) (i64.const 48)
      (i64.extend_i32_u (global.get $exchange)) (i64.const 8) (i64.const 80)))

  (func $read (param $request i32) (param $sequence i64)
    (local $attempts i32)
    (local $status i32)
    (local $until i64)
    (local.set $until (call $deadline (local.get $request)))
    (i64.store (i32.const 32) (local.get $sequence))
    (loop $submit_again
      (local.set $status (call $send (local.get $request) (local.get $sequence) (local.get $until)))
      (if (i32.eq (local.get $status) (i32.const 11))
        (then
          (local.set $attempts (i32.add (local.get $attempts) (i32.const 1)))
          (br_if $submit_again (i32.lt_u (local.get $attempts) (i32.const 4000000))))))
    (call $check (i32.eqz (local.get $status)))
    (call $check (i64.eq (i64.load (global.get $exchange)) (local.get $sequence)))
    (call $check (i32.eqz (call $poll (i32.const 1))))
    (call $check (i64.eq (i64.load (i32.const 80)) (i64.const 40)))
    (call $check (i64.eqz (i64.load (global.get $exchange))))
    (call $check (i64.eq (i64.load offset=8 (global.get $exchange)) (i64.const 24)))
    (call $check (i64.eq (i64.load offset=16 (global.get $exchange)) (i64.const 16))))

  (func $run (param $live i32)
    (local $request i32)
    (local $first_tick i64)
    (call $check (memtag.status $private))
    (global.set $exchange (memtag.claim $private (i32.const 128) (i32.const 1040)))
    (local.set $request (memtag.claim $private (i32.const 1280) (i32.const 48)))
    (call $init_clock (local.get $request))
    (call $check (i32.eqz (call $open (i32.const 0) (i64.const 16) (i64.const 9) (i64.const 64))))
    (global.set $cap (i64.load (i32.const 64)))
    (call $check (i32.eqz (call $poll (i32.const 0))))
    (call $read (local.get $request) (i64.const 1))
    (if (local.get $live)
      (then
        (local.set $first_tick (i64.load offset=24 (global.get $exchange)))
        (call $check (i64.gt_u (local.get $first_tick) (i64.const 0)))
        (call $check (i64.le_u (local.get $first_tick) (i64.const 0xffffffff)))
        (call $check (i64.le_u (i64.load offset=32 (global.get $exchange)) (i64.const 0xffffffff)))
        (call $read (local.get $request) (i64.const 2))
        (call $check (i64.gt_u (i64.load offset=24 (global.get $exchange)) (local.get $first_tick)))
        (call $check (i64.le_u (i64.load offset=24 (global.get $exchange)) (i64.const 0xffffffff)))
        (call $check (i64.le_u (i64.load offset=32 (global.get $exchange)) (i64.const 0xffffffff))))
      (else
        (call $check (i64.eq (i64.load offset=24 (global.get $exchange)) (i64.const 41347)))
        (call $check (i64.eq (i64.load offset=32 (global.get $exchange)) (i64.const 0x3e000000)))))
    (call $check (i32.eqz (call $disconnect (global.get $cap) (i32.const 0) (i64.const 0)
      (i64.const 0) (i64.extend_i32_u (global.get $exchange)) (i64.const 8) (i64.const 80))))
    (memory.fill (local.get $request) (i32.const 0) (i32.const 48))
    (memory.fill (global.get $exchange) (i32.const 0) (i32.const 1040))
    (drop (memtag.release $private (local.get $request) (i32.const 48)))
    (drop (memtag.release $private (global.get $exchange) (i32.const 1040))))
  (func $recorded (call $run (i32.const 0)))
  (func $live (call $run (i32.const 1)))
  (export "_start" (func $recorded)))
